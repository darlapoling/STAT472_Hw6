pacman::p_load(ggplot2, knitr, dplyr, lmerTest)
#| label: data-import
# Import and clean your data here
# Example:
# data <- read.csv("path/to/data.csv")
#data <- data.frame(x = c(1, 2, 3, 4, 5), y = c(2, 4, 3, 5, 7))
buttermilk <- read.table("~/Documents/GitHub/STAT445_Hw11/buttermilk.txt", header = TRUE)
buttermilk <- buttermilk |>
dplyr::mutate(
block = factor(block),
position = factor(position),
brand = factor(brand)
)
golf.ball <- read.table("~/Documents/GitHub/STAT445_Hw11/golf.ball.txt", header = TRUE)
#| label: tbl-data-summary
#| tbl-cap: "Summary Statistics of Key Variables"
# Create summary statistics table
# Example:
# data |>
#   summary() |>
#   knitr::kable()
fit_mixed <- lmerTest::lmer(
y ~ brand + (1 | block),
data = buttermilk
)
# Type III ANOVA with Satterthwaite df
anova(fit_mixed, type = "III")
plot(fit_mixed)
