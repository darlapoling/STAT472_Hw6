)
#| label: tbl-data-summary
#| tbl-cap: "Summary Statistics of Key Variables"
# Create summary statistics table
# Example:
# data |>
#   summary() |>
#   knitr::kable()
model <- lm(y ~ day + order + trtmt, data = video.game)
plot(model)
data1 <- video.game[video.game$trtmt == "1", ]
sum(data1$y)
data2 <- video.game[video.game$trtmt == "2", ]
sum(data2$y)
data3 <- video.game[video.game$trtmt == "3", ]
sum(data3$y)
data4 <- video.game[video.game$trtmt == "4", ]
sum(data4$y)
data5 <- video.game[video.game$trtmt == "5", ]
sum(data5$y)
video.game |>
dplyr::group_by(order) |>
dplyr::summarise(B_h = sum(y), .groups = "drop")
video.game |>
dplyr::group_by(day) |>
dplyr::summarise(C_q = sum(y), .groups = "drop")
sum_y_sq <- sum(video.game$y^2)
G <- sum(video.game$y)
N <- nrow(video.game)
CF <- G^2 / N
print(CF)
SS_total <- sum_y_sq - CF
cat("Sum of Y^2 =", sum_y_sq, "\nCF =", round(CF, 2), "\nSS_Total =", round(SS_total, 2))
B_h <- c(517, 455, 394, 479, 488)
SS_row <- sum(B_h^2) / 5 - CF
cat("SS_Row (Cow) =", round(SS_row, 2))
C_q <- c(505, 465, 475, 443, 445)
SS_col <- sum(C_q^2) / 5 - CF
cat("SS_Col (Period) =", round(SS_col, 2))
T_i <- c(386, 495, 475, 466, 511)
SS_trt <- sum(T_i^2) / 5 - CF
cat("SS_Trt (Diet) =", round(SS_trt, 2))
SS_error <- SS_total - SS_row - SS_col - SS_trt
cat("SS_Error =", round(SS_error, 2))
# Construct ANOVA table by hand
df_row <- 4; df_col <- 4; df_trt <- 4; df_error <- 12
MS_row <- SS_row / df_row
MS_col <- SS_col / df_col
MS_trt <- SS_trt / df_trt
MS_error <- SS_error / df_error
F_trt <- MS_trt / MS_error
anova_hand <- data.frame(
Source = c("Cow (Row)", "Period (Col)", "Diet (Trt)", "Error", "Total"),
df = c(df_row, df_col, df_trt, df_error, 25),
SS = round(c(SS_row, SS_col, SS_trt, SS_error, SS_total), 2),
MS = c(round(MS_row, 2), round(MS_col, 2), round(MS_trt, 2), round(MS_error, 2), NA),
F_ratio = c(NA, NA, round(F_trt, 2), NA, NA),
p_value = c(NA, NA, round(1 - pf(F_trt, df_trt, df_error), 4), NA, NA)
)
kableExtra::kbl(anova_hand, col.names = c("Source", "df", "SS", "MS", "F", "p-value"),
align = "lrrrrr") |>
kableExtra::kable_styling(bootstrap_options = c("striped", "hover"))
p_val <- 1 - pf(F_trt, df_trt, df_error)
s_val <- -log2(p_val)
cat("F =", round(F_trt, 2), "\np =", round(p_val, 4), "\ns =", round(s_val, 1), "bits")
cat("\nMS_row =", round(MS_row, 2), "\nMS_col =", round(MS_col, 42), "\nMS_error =", round(MS_error, 2))
